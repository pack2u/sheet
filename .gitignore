# ══════════════════════════════════════
# Pack2U 상품정보시트 .gitignore
# ══════════════════════════════════════

# ★ 비밀 키 파일 (절대 커밋 금지)
_secrets.gs

# 백업 폴더
0521_backup/
backup_20260412/
backup_20260613/

# 대용량 바이너리
*.xlsx
*.docx

# 스크래치/임시
scratch/
antigravity_ide/

# IDE / 에디터
.cursor/
.vscode/
*.swp
*.swo
*~

# OS 파일
Thumbs.db
.DS_Store
desktop.ini

# 의존성 (웹앱 로컬 개발용, 커밋 대상 아님)
node_modules/

# 백업 폴더 전체 (.claspignore 와 동일 규칙)
backup_*/

# 서비스 계정 키 자리 (절대 커밋 금지)
sa-key-temp.json
*-key*.json

# 로젠 중계기 설정 — 인증키가 들어간다. 견본(relay_config.sample.php)만 올린다
_logen_relay/relay_config.php

# 사방넷 중계기 설정 — clientCd·시크릿이 들어간다. 견본(sabang_config.sample.php)만 올린다
_sabang_relay/sabang_config.php
# 중계기가 캐시한 JWT
_sabang_relay/.token_*.json

# 쿠팡 중계기 설정 — 중계기 열쇠가 들어간다. 견본(coupang_config.sample.php)만 올린다
# (쿠팡 비밀키는 여기 없다 — 서명은 v2 가 만든다)
_coupang_relay/coupang_config.php

# FTP 접속 정보 — 비밀번호가 들어간다. 절대 올리지 않는다
_sabang_relay/_ftp.json
_coupang_relay/_ftp.json
