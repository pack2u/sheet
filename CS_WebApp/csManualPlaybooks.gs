/** 플레이북 → 검색용 레코드 */
function csPlaybookToRecord_(pb) {
  var stepLines = (pb.steps || []).map(function(s, i) {
    return (i + 1) + ". " + s;
  });
  var checkLines = (pb.checklist || []).map(function(c) {
    return "□ " + c;
  });
  var bodyParts = [];
  if (pb.trigger) bodyParts.push("【언제】" + pb.trigger);
  if (pb.statusFlow) bodyParts.push("【상태흐름】" + pb.statusFlow);
  if (stepLines.length) bodyParts.push("【처리단계】\n" + stepLines.join("\n"));
  if (checkLines.length) bodyParts.push("【체크】" + checkLines.join(" · "));
  if (pb.caution) bodyParts.push("【주의】" + pb.caution);
  if (pb.tools) bodyParts.push("【도구】" + pb.tools);

  return {
    id: "guide|" + pb.id,
    source: "처리가이드",
    category: pb.category || "공통",
    title: pb.title,
    body: bodyParts.join("\n"),
    trigger: pb.trigger || "",
    statusFlow: pb.statusFlow || "",
    steps: pb.steps || [],
    checklist: pb.checklist || [],
    caution: pb.caution || "",
    tools: pb.tools || "",
    keywords: (pb.keywords || []).join(" "),
    date: "",
    status: "",
    ts: 9000000000000,
    seq: 0,
    priority: 100
  };
}

function csLoadPlaybookRecords_() {
  var pbs = csGetManualPlaybooks_();
  var out = [];
  for (var i = 0; i < pbs.length; i++) {
    out.push(csPlaybookToRecord_(pbs[i]));
  }
  return out;
}
