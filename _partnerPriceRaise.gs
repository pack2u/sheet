function _pr_readChecked_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var tab = ss.getSheetByName(_PR_TAB_);
  if (!tab) throw new Error("먼저 「📋 비교표 만들기」를 눌러 주세요.");
  var last = tab.getLastRow();
  if (last < 2) return { tab: tab, 줄: [] };
  var vals = tab.getRange(2, 1, last - 1, _PR_HEADERS_.length).getValues();
  var out = [];
  for (var i = 0; i < vals.length; i++) {
    if (vals[i][_PR_C.적용 - 1] !== true) continue;
    out.push({ 행: i + 2, v: vals[i] });
