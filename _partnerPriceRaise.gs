/**
 * ══════════════════════════════════════════════════════════════
 *  [협력업체] 단가 인상 적용 — 정희화학 · 콤콤  (2026.10.12 인상분)
 *  2026-10-09
 *
 *  > "화일을 읽고 정희10월인상단가라는 시트로 만들어는데 지금상품정보시트의
 *  >  단가와 비교하고 인상단가를 상품정보시트에 적용되는 스크립트를 만들어줘"
 *  > "시트에서 확인 체크하는 열을 만들어서 체크한 부분만 적용되게"
 *
 *  ★ 왜 「체크한 것만」인가 ★
 *    업체 단가표의 품명과 우리 상품명이 다르다. 기계가 붙인 것 가운데
 *    틀린 것이 섞인다. 틀린 줄에 단가를 적으면 «엉뚱한 품목»이 비싸진다 —
 *    그 뒤로 발주·명세서·정산이 전부 그 값을 믿는다. 되돌리기 어렵다.
 *    그래서 사람이 눈으로 보고 체크한 줄만 간다.
 *
 *  ★ 어떻게 맞췄나 ★  길이 셋이다. 센 것부터 쓴다.
 *    ① 배운짝   9월 정산 두 파일(이카운트·업체원장)을 «공급가액»으로 이어
 *               얻은 「업체품명 ↔ 우리상품명」. 수량도 단가도 단위가 달라
 *               두 쪽에서 같은 수는 금액뿐이다. 짐작이 아니라 실제 거래다.
 *    ② 낱말+값  이름의 낱말이 겹치고 종전단가도 같다. 크기(소·중·대)는
 *               반드시 같아야 한다 — 섞이면 돈이 틀린다.
 *    ③ 값만     종전단가만 같다. 같은 단가를 쓰는 품목이 수십 개라 혼자서는
 *               못 믿는다. 기본으로 체크를 «끈다».
 *
 *  ★ 안 건드리는 것 ★
 *    · 소분 줄   단가가 따로 계산되는 자리다
 *    · 세트 줄   몸통+뚜껑 합이라 낱개가를 그대로 쓰면 안 된다.
 *                업체가 비고에 적어 준 「셋」 값이 있을 때만 제안한다
 *
 *  쓰는 차례
 *    ① 📋 비교표 만들기        «10월인상단가» 탭이 생긴다
 *    ② 눈으로 보고 A열 체크     ①②는 미리 켜 두었다. ③과 못 찾은 줄은 꺼져 있다
 *                              주황 줄은 「우리코드」에 이카운트코드를 넣으면 적용된다.
 *                              우리가 «안 파는» 품목이면 그 칸에 「미판매」라고 적는다 —
 *                              회색이 되고 셈에서 빠진다. 다시 만들어도 남는다
 *    ③ 🧪 미리보기             바꾸지 않고 몇 줄이 어떻게 바뀌는지만 본다
 *    ④ 💾 상품정보에 적용       개당매입별도가·개당매입가를 바꾼다
 *    ⑤ 🔗 누적품목매핑에 적용   업체품명 ↔ 우리품목 짝을 쌓아 둔다
 * ══════════════════════════════════════════════════════════════
 */

/**
 * 줄 색.
 * > 「이게 적용된것들은 셀칼라가 노란색으로 표시 되게 해줘」 (2026-10-11)
 *
 * 적용 결과는 「적용결과」 칸 글만으로는 357줄 속에서 안 보인다. 줄째로 칠한다.
 * 노랑은 자사몰 로고에서 뽑은 브랜드색이다([[pack2u-brand-yellow]]).
 * 못 찾은 줄은 따로 칠한다 — 체크해도 «적용이 안 되는» 줄이라 미리 보여야 한다.
 */
var _PR_DONE_BG_ = "#FDB813";   // 적용됨 — 브랜드 노랑
var _PR_MISS_BG_ = "#FCE5CD";   // 우리코드를 못 찾음 — 손으로 넣어야 한다
var _PR_NA_BG_   = "#D9D9D9";   // 우리가 안 파는 품목 — 못 붙어도 맞다

/**
 * 「우리가 안 파는 품목」이라고 적어 두는 낱말.
 * > 「미매칭건은 상품정보시트에 없는 경우도 많아.. 우리가 판매하지 않는 품목」
 *
 * 못 찾은 줄을 다 결함으로 보면 매번 같은 38줄을 다시 들여다보게 된다.
 * 그중 상당수는 ★애초에 우리가 안 파는 품목★ 이라 못 붙는 것이 맞다.
 * 우리코드 칸에 아래 낱말 중 하나를 적어 두면
 *   · 회색으로 칠해 「볼 것 없음」으로 구분하고
 *   · 「못 찾았는데 단가가 오른 것」 셈에서 뺀다(헛경보를 없앤다)
 *   · 체크가 켜져 있어도 적용하지 않는다
 * 비교표를 다시 만들어도 이 표시는 그대로 옮겨 온다.
 */
var _PR_NA_WORDS_ = ["미판매", "미취급", "안씀", "안함"];
function _pr_isNA_(글) {
  var t = String(글 == null ? "" : 글).trim();
  if (!t) return false;
  for (var i = 0; i < _PR_NA_WORDS_.length; i++) if (t === _PR_NA_WORDS_[i]) return true;
  return false;
}

