/**  꼬리에 붙일 구매처 쪽지. 같으면 아무것도 안 붙인다. */
function _pr_vendorTail_(맞나) { return 맞나 === "다름" ? "·구매처다름" : ""; }

function _pr_vendorFit_(u, 업체) {
  if (!u.vendor) return "빈칸";
