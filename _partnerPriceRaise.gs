    ui.ButtonSet.YES_NO);
  if (답 !== ui.Button.YES) return;

  /*  ★ 바꾸기 «전»에 적어 둔다 ★ 덮어쓰고 나면 옛 값을 되짚을 데가 없다.
      실제로 단가는 여러 곳이 믿는 값이라, 잘못 바꿨을 때 되돌릴 길이 있어야 한다. */
  var 이력 = [];
