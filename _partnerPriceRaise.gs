/* ─────────────────────────────────────────────────────────────
   이름 다듬기 — 맞대기 전에 글자를 고른다
   ───────────────────────────────────────────────────────────── */
function _pr_norm_(s) {
  return String(s == null ? "" : s)
    .replace(/---[\s\S]*$/, "").replace(/===[\s\S]*$/, "")
    .replace(/\[샘플\]/g, "")
    .replace(/[()\[\]{}★]/g, "")
    .replace(/[\s,·\/]+/g, "")
    .replace(/^JH/i, "")
    .toLowerCase();
}

/*  업체 원장 이름은 꼬리가 붙는다 — 「23195/백색」·「105파이대셋/백색/1000셋트」.
    색과 수량 꼬리를 떼면 단가표 품명에 가까워진다. */
function _pr_vnorm_(s) {
  var t = String(s == null ? "" : s)
    .replace(/\/(백색|검정|투명|흑색|블랙|화이트|투톤)/g, "")
    .replace(/\/?\d+\s*(셋트|셋|개입|개|매)/g, "")
    .replace(/\(\d+번[^)]*\)/g, "");
  return _pr_norm_(t);
}

var _PR_SIZE_ = ["특대", "특소", "왕대", "대", "중", "소"];

/** 뜻이 있는 낱말만. 두 자 미만은 안 쓴다 — 「소」 하나로 걸면 소스·소분이 다 걸린다. */
function _pr_words_(s) {
  var t = _pr_norm_(s), out = {}, m, i;
  var han = t.match(/[가-힣]{2,}/g) || [];
  for (i = 0; i < han.length; i++) {
    var w = han[i];
    for (var k = 0; k < _PR_SIZE_.length; k++) w = w.split(_PR_SIZE_[k]).join("");
    if (w.length >= 2) out[w] = true;
  }
  var num = t.match(/\d{2,}/g) || [];
  for (i = 0; i < num.length; i++) out[num[i]] = true;
  var r = [];
  for (var key in out) r.push(key);
  return r;
}

function _pr_size_(s) {
  var t = _pr_norm_(s);
  for (var i = 0; i < _PR_SIZE_.length; i++) if (t.indexOf(_PR_SIZE_[i]) >= 0) return _PR_SIZE_[i];
  return "";
}

/** 그 줄이 세트인가 몸통인가 뚜껑인가 */
function _pr_kind_(name) {
  var s = String(name || "");
  if (/몸통만/.test(s)) return "몸통";
  if (/뚜껑만/.test(s)) return "뚜껑";
  if (/소분/.test(s)) return "소분";
  /*  ★ 「200set」을 못 읽었다 ★  (2026-10-12)
      \bSET\b 은 「200set」에서 0 과 s 가 둘 다 낱말글자라 경계가 없어 안 걸렸다.
      그래서 「CC 195파이 면 (구냉면) 대 블랙 200set」이 「그밖」이 되어
      ★세트 칸에 몸통 단가★ 를 넣으려 했다(84원, 현재는 136원).
      앞 글자가 «영문이 아니면» 세트로 본다 — 숫자는 되고 offset 은 안 된다.  */
  if (/(^|[^a-z])set\b/i.test(s) || /세트/.test(s)) return "세트";
  return "그밖";
}

