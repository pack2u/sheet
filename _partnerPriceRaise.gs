    else if (!(Number(적용후) > 0)) 사유 = "적용후 단가가 0 이하입니다";
    else if (byCode[code].net != null && Number(byCode[code].net) === Number(적용후)) 사유 = "이미 같은 값입니다";

    if (사유) { 건너뜀.push(사유); 결과.push([("건너뜀 — " + 사유)]); continue; }
