/*  ★ 빗장을 풀었다 ★  (2026-10-12) 세 까닭을 다 막고, 열세 가지로 깨서
    다 우는 것을 보고 풀었다. 다시 수상하면 여기를 true 로 올리면 멈춘다. */
var _PR_APPLY_STOP_ = false;

function _pr_applyProduct_(미리, 정말) {
