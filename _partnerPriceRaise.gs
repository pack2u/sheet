    색과 수량 꼬리를 떼면 단가표 품명에 가까워진다. */
function _pr_vnorm_(s) {
  var t = String(s == null ? "" : s)
    .replace(/\/(백색|검정|투명|흑색|블랙|화이트|투톤)/g, "")
    .replace(/\/?\d+\s*(셋트|셋|개입|개|매)/g, "")
    .replace(/\(\d+번[^)]*\)/g, "");
  return _pr_norm_(t);
}

var _PR_SIZE_ = ["특대", "특소", "왕대", "대", "중", "소"];

/** 뜻이 있는 낱말만. 두 자 미만은 안 쓴다 — 「소」 하나로 걸면 소스·소분이 다 걸린다. */
function _pr_words_(s) {
  var t = _pr_norm_(s), out = {}, m, i;
  var han = t.match(/[가-힣]{2,}/g) || [];
  for (i = 0; i < han.length; i++) {
    var w = han[i];
    for (var k = 0; k < _PR_SIZE_.length; k++) w = w.split(_PR_SIZE_[k]).join("");
    if (w.length >= 2) out[w] = true;
  }
  var num = t.match(/\d{2,}/g) || [];
  for (i = 0; i < num.length; i++) out[num[i]] = true;
  var r = [];
  for (var key in out) r.push(key);
  return r;
}

function _pr_size_(s) {
  var t = _pr_norm_(s);
  for (var i = 0; i < _PR_SIZE_.length; i++) if (t.indexOf(_PR_SIZE_[i]) >= 0) return _PR_SIZE_[i];
  return "";
}

/** 그 줄이 세트인가 몸통인가 뚜껑인가 */
function _pr_kind_(name) {
  var s = String(name || "");
  if (/몸통만/.test(s)) return "몸통";
  if (/뚜껑만/.test(s)) return "뚜껑";
  if (/소분/.test(s)) return "소분";
  if (/\bSET\b|세트/i.test(s)) return "세트";
  return "그밖";
}

/* ─────────────────────────────────────────────────────────────
   상품정보 읽기
   ───────────────────────────────────────────────────────────── */
function _pr_loadProducts_() {
  var ss = _pr_ss_();
  var tab = ss.getSheetByName(_PR_PRODUCT_TAB_);
  if (!tab) throw new Error("「" + _PR_PRODUCT_TAB_ + "」 탭을 못 찾았습니다.");
  var lastRow = tab.getLastRow();
  if (lastRow <= _PR_P_HEADER_ROW_) return [];
  var w = Math.max(tab.getLastColumn(), _PR_P_GROSS_);
  var vals = tab.getRange(_PR_P_HEADER_ROW_ + 1, 1, lastRow - _PR_P_HEADER_ROW_, w).getValues();
  var out = [];
  for (var i = 0; i < vals.length; i++) {
    var r = vals[i];
    var code = String(r[_PR_P_CODE_ - 1] || "").trim();
    var name = String(r[_PR_P_NAME_ - 1] || "").trim();
    if (!code || !name) continue;
    if (/\[샘플\]/.test(name)) continue;          // 샘플은 재고가 아니라 전시용이다
    var net = r[_PR_P_NET_ - 1];
    out.push({
      row: _PR_P_HEADER_ROW_ + 1 + i,
      code: code, name: name,
      vendor: String(r[_PR_P_VENDOR_ - 1] || "").trim(),
      net: (net === "" || net == null) ? null : Number(net),
      kind: _pr_kind_(name),
      norm: _pr_norm_(name),
    });
  }
  return out;
}

function _pr_isVendor_(u, 업체) {
  if (u.vendor) return u.vendor.indexOf(업체) >= 0;
  //  구매처가 비었으면 코드 머리로 가린다. 정희만 규칙이 뚜렷하다(JH…).
  return 업체 === "정희" && /^JH/i.test(u.code);
}

/* ─────────────────────────────────────────────────────────────
   맞대기 — 길 셋
   ───────────────────────────────────────────────────────────── */
/**
 * ⓞ 고친짝 — ★사람이 바로잡은 짝★. 모든 셈보다 앞선다.
 *
 * ★ 왜 파일에 박나 ★  (2026-10-12)
 * > 「매칭 잘못된거도 수정해놨어」
 *
 * 사장님이 비교표에서 틀린 짝 15개를 고쳐 두셨는데, 비교표를 다시 만들면
 * ②이름·③값 셈이 ★그 틀린 짝을 그대로 되돌린다★. 누적품목매핑에 쌓아도
 * 소용없다 — ①배운짝은 그 탭을 읽지 않고 _PR_PAIR_ 를 본다
 * ([[price-match-reads-embedded-pairs]]).
 *
 * 그래서 여기에 적는다. 아래 값은 2026-10-12 미리보기 로그에 「새 셈에
 * 없습니다」로 찍힌 15줄을 그대로 옮긴 것이다 — 내가 고른 짝이 아니다.
 * 업체품명 7개는 단가표(_PR_PRICE_)에 그 글자로 있는지 확인했다.
 *
 * ★ 68파이소·12144 용기는 한 품명에 여러 코드다 ★ 포장 단위(100*1/5/15)와
 * 색(화이트·블랙)이 갈린다. 셈으로는 못 가른다 — 사람이 가른 것이다.
 *
 * 코드가 상품정보에 없으면 ★조용히 버리지 않고 로그에 적고★ 보통 셈으로
 * 넘어간다. 그러면 「새 셈에 없습니다」 경고가 다시 울어 눈에 띈다.
 */
var _PR_FIX_ = {
  "정희|70호뚜껑(2318)": ["MASL0123"],
  /*  ★ 흰것만 넣었던 것을 고쳤다 ★  (2026-10-12)
      9월 원장에 있는 것은 「23199/검정」 117원이고 단가표 23199 종전도 117 이다.
      ★우리가 실제로 산 것은 검정★ 이다. 흰것만 올리면 검정은 옛 단가로 산다. */
  "정희|23199": ["JH2319SL0007", "JH2319SL0016"],
  "정희|68파이소": ["JH70SAUCE10003", "JH70SAUCE00010", "JH70SAUCE15001",
                    "JH70SAUCEB10001", "JH70SAUCE00011", "JH70SAUCE15002"],
  "정희|감자탕뚜껑": ["MAJHG0022"],
  "콤콤|12144 용기": ["HPKANB00002", "HPKANB30002", "HPKAN30001", "HPKAN30002"],
  "콤콤|G냉면(대)": ["JHNMSETB0002"],
  "콤콤|냉면(대)": ["FPNMTANG00010"]
};

function _pr_match_(p, prods) {
  var 업체 = p[0], 품명 = p[2], 종전 = p[4];
  var key = _pr_norm_(품명);
  var i, u;

  /*  ⓞ 사람이 바로잡은 짝 — 셈보다 앞선다. 한 값에 주인은 하나고,
      이 값의 주인은 사람이다([[one-value-one-owner]]).               */
  var 고친 = _PR_FIX_[업체 + "|" + String(품명 == null ? "" : 품명).trim()];
  if (고친 && 고친.length) {
    var 본0 = [], 빠진 = [];
    for (i = 0; i < 고친.length; i++) {
      var 찾 = null;
      for (var j0 = 0; j0 < prods.length; j0++) {
        if (prods[j0].code === 고친[i]) { 찾 = prods[j0]; break; }
      }
      if (찾) 본0.push({ u: 찾, 원장: "" }); else 빠진.push(고친[i]);
    }
    /*  ★ 못 찾은 코드를 조용히 버리지 않는다 ★ 상품정보에서 코드가 바뀌면
        여기만 옛 코드로 남는다. 로그에 적어 두면 다음에 보인다.        */
    if (빠진.length) Logger.log("[ⓞ고친짝] 상품정보에 없는 코드 — " +
      업체 + " · " + 품명 + " · " + 빠진.join(", "));
    if (본0.length) return { 근거: "ⓞ고친짝", 목록: 본0 };
  }

  //  ① 배운짝
  var 짝 = [];
  for (i = 0; i < _PR_PAIR_.length; i++) {
    var b = _PR_PAIR_[i];
    if (b[0] !== 업체) continue;
    var bn = _pr_vnorm_(b[1]);
    if (!bn || !key) continue;
    if (bn !== key && bn.indexOf(key) < 0 && key.indexOf(bn) < 0) continue;
    짝.push(b);
  }
  if (짝.length) {
    var 본 = [], 봤다 = {};
    for (i = 0; i < 짝.length; i++) {
      for (var j = 0; j < prods.length; j++) {
        if (prods[j].name !== 짝[i][3]) continue;
        if (봤다[prods[j].code]) continue;
        봤다[prods[j].code] = true;
        본.push({ u: prods[j], 원장: 짝[i][1] });
      }
    }
    if (본.length) {
      //  업체가 적어 준 단가가 종전단가와 맞으면 한 겹 더 믿는다
      var 단가맞 = false;
      for (i = 0; i < 짝.length && !단가맞; i++) {
        var parts = String(짝[i][4]).split(" / ");
        for (var q = 0; q < parts.length; q++) {
          if (종전 != null && Math.abs(Number(parts[q]) - 종전) < 0.51) { 단가맞 = true; break; }
        }
      }
      return { 근거: 단가맞 ? "①배운짝+단가확인" : "①배운짝", 목록: 본 };
    }
  }

  //  ② 이름이 통째로 들어 있나
  var 이름후 = [];
  for (i = 0; i < prods.length; i++) {
    u = prods[i];
    if (!_pr_isVendor_(u, 업체)) continue;
    if (key && u.norm.indexOf(key) >= 0) 이름후.push({ u: u, 원장: "" });
  }
  if (이름후.length && 이름후.length <= 16) return { 근거: "②이름", 목록: 이름후 };

  //  ②' 낱말이 겹치고 값도 같다 (크기는 반드시 같아야 한다)
  if (종전 != null) {
    var ws = _pr_words_(품명), sz = _pr_size_(품명), 낱후 = [];
    for (i = 0; i < prods.length; i++) {
      u = prods[i];
      if (!_pr_isVendor_(u, 업체)) continue;
      if (u.net == null || Math.abs(u.net - 종전) >= 0.51) continue;
      var 겹 = false;
      for (var k2 = 0; k2 < ws.length; k2++) if (u.norm.indexOf(ws[k2]) >= 0) { 겹 = true; break; }
      if (!겹) continue;
      var sz2 = _pr_size_(u.name);
      if (sz && sz2 && sz !== sz2) continue;
      낱후.push({ u: u, 원장: "" });
    }
    if (낱후.length && 낱후.length <= 16) return { 근거: "②'낱말+값", 목록: 낱후 };
  }

  //  ③ 값만 — 마지막. 셋 이하일 때만, 그리고 기본으로 체크를 끈다.
  if (종전 != null) {
    var 값후 = [];
    for (i = 0; i < prods.length; i++) {
      u = prods[i];
      if (!_pr_isVendor_(u, 업체)) continue;
      if (u.net != null && Math.abs(u.net - 종전) < 0.51) 값후.push({ u: u, 원장: "" });
    }
    if (값후.length && 값후.length <= 3) return { 근거: "③값만(약함)", 목록: 값후 };
    if (이름후.length) return { 근거: "✖ 후보 " + 이름후.length + "줄 — 너무 많음", 목록: [] };
  }
  return { 근거: "✖ 못 찾음", 목록: [] };
}

/** 비고의 「셋51.5」에서 세트 새 단가를 읽는다. 없으면 null. */
function _pr_setPrice_(비고) {
  var m = String(비고 || "").match(/셋\s*([0-9]+(?:\.[0-9]+)?)/);
  return m ? Number(m[1]) : null;
}

/* ─────────────────────────────────────────────────────────────
   편집기에서도 돌게 — 창과 활성시트에 기대지 않는다

   ★ 2026-10-11 에 여기서 멈췄다 ★
     Exception: Cannot call SpreadsheetApp.getUi() from this context.
     사장님이 편집기에서 partnerPriceRaiseBuild 를 눌렀는데 539행에서
     터졌다. 메뉴에서 부를 때만 창이 있다 — 편집기에는 창이 없다.
     getActiveSpreadsheet() 도 같은 꼴로 null 이 될 수 있다.

     이 일은 «한 번 눌러서 끝내는» 일이라 편집기에서 돌리는 것이 정상이다.
     그러니 창이 없으면 실행로그에 적고, 시트는 ID 로 연다.
   ───────────────────────────────────────────────────────────── */

/** 1 → A · 19 → S. 줄을 범위 글로 칠할 때 쓴다 */
function _pr_colLetter_(n) {
  var t = "";
  while (n > 0) { var m = (n - 1) % 26; t = String.fromCharCode(65 + m) + t; n = (n - m - 1) / 26; }
  return t;
}

/** 줄 여럿을 한 번에 칠한다. 한 줄씩 부르면 357번이라 느리다 */
function _pr_paint_(tab, 줄들, 색) {
  if (!줄들 || !줄들.length) return;
  var 끝열 = _pr_colLetter_(_PR_HEADERS_.length);
  var 자리 = [];
  for (var i = 0; i < 줄들.length; i++) 자리.push("A" + 줄들[i] + ":" + 끝열 + 줄들[i]);
  try { tab.getRangeList(자리).setBackground(색); }
  catch (e) { Logger.log("[색] 칠하지 못했습니다 — " + e.message); }
}

/**
 * 탭 전체를 지금 상태대로 다시 칠한다.
 *
 * ★ 색의 주인을 한 곳으로 모았다 ★  (2026-10-11)
 * 전에는 비교표 만들 때 주황을, 적용할 때 노랑을 각자 칠했다. 그러면
 * 사장님이 나중에 손으로 적은 것(코드·미판매)은 ★영영 색이 안 바뀐다★.
 * 색을 정하는 자리를 하나로 두고, 만들 때·적용할 때·부를 때 모두
 * 이 함수를 지난다([[one-value-one-owner]]).
 *
 * 차례가 곧 뜻이다 — 앞선 것이 이긴다.
 *   ✅ 적용됨   노랑    단가를 실제로 바꾼 줄
 *   미판매      회색    우리가 안 파는 품목 — 볼 것 없음
 *   코드 없음   주황    체크해도 적용이 안 된다 — 코드를 넣어야 한다
 *   그밖        흰색    평소 줄
 */
function _pr_recolor_(tab) {
  var last = tab.getLastRow();
  if (last < 2) return { 적용: 0, 미판매: 0, 코드없음: 0 };
  var vals = tab.getRange(2, 1, last - 1, _PR_HEADERS_.length).getValues();
  var 노랑 = [], 회색 = [], 주황 = [], 흰색 = [];
  for (var i = 0; i < vals.length; i++) {
    var 행 = i + 2;
    var 결 = String(vals[i][_PR_C.결과 - 1] || "");
    var 코드 = String(vals[i][_PR_C.우리코드 - 1] || "").trim();
    if (결.indexOf("✅") === 0) 노랑.push(행);
    else if (_pr_isNA_(코드)) 회색.push(행);
    else if (!코드) 주황.push(행);
    else 흰색.push(행);
  }
  _pr_paint_(tab, 흰색, null);          // 되돌아간 줄을 남겨 두지 않는다
  _pr_paint_(tab, 주황, _PR_MISS_BG_);
  _pr_paint_(tab, 회색, _PR_NA_BG_);
  _pr_paint_(tab, 노랑, _PR_DONE_BG_);
  return { 적용: 노랑.length, 미판매: 회색.length, 코드없음: 주황.length };
}

/**  손으로 적은 뒤 색만 맞추고 싶을 때. 아무 값도 바꾸지 않는다.  */
function partnerPriceRaiseRecolor() {
  var tab = _pr_ss_().getSheetByName(_PR_TAB_);
  if (!tab) { _pr_say_("「" + _PR_TAB_ + "」 탭이 없습니다."); return; }
  var n = _pr_recolor_(tab);
  _pr_say_("🎨 색을 다시 칠했습니다 — 값은 그대로입니다\n\n" +
    "  적용됨(노랑) " + n.적용 + "  ·  미판매(회색) " + n.미판매 +
    "  ·  코드 없음(주황) " + n.코드없음);
}

/** 창이 있으면 창에, 없으면 실행로그에 */
function _pr_say_(글) {
  Logger.log(글);
  try { SpreadsheetApp.getUi().alert(글); } catch (e) { /* 편집기 — 로그로 충분하다 */ }
}

/**
 * 「진행할까요?」 — 창이 있으면 묻고, 없으면 ★안 하고 멈춘다★.
 *
 * ★ 창이 없을 때 그냥 진행하면 안 된다 ★ 편집기에서 ▶ 를 잘못 누르면
 *   체크해 둔 줄(수백 줄)의 단가가 그대로 바뀐다. 묻는 자리가 없어졌다고
 *   묻기를 그만두는 것은
 *   안전을 빼서 편함에 주는 바꿈이다.
 *   대신 편집기에서 쓸 «다른 이름»을 알려 준다 — 그 이름을 고르는 것이
 *   편집기에서의 「예」 다. (묵은건 종결의 DryRun/Apply 와 같은 결)
 *
 * @param {boolean} 정말 편집기용 함수가 true 로 넘긴다
 * @return {boolean} 진행해도 되나
 */
function _pr_ask_(제목, 본문, 정말, 편집기이름) {
  var ui = null;
  try { ui = SpreadsheetApp.getUi(); } catch (e) { ui = null; }
  if (ui) {
    var 답 = ui.alert(제목, 본문 + "\n\n진행할까요?", ui.ButtonSet.YES_NO);
    return 답 === ui.Button.YES;
  }
  if (정말) { Logger.log("[" + 제목 + "] 편집기에서 «정말» 로 불렀습니다 — 진행합니다."); return true; }
  Logger.log("■ " + 제목 + "\n" + 본문 +
    "\n\n★ 아무것도 안 했습니다 ★ 편집기에는 「예」를 누를 창이 없습니다.\n" +
    "   정말 하시려면 함수 «" + 편집기이름 + "» 을 골라 실행하십시오.");
  return false;
}

/** 상품정보시트. 활성시트에 기대지 않는다 — 편집기에서는 없다 */
function _pr_ss_() {
  try {
    var a = SpreadsheetApp.getActiveSpreadsheet();
    if (a) return a;
  } catch (e) { /* 편집기 */ }
  return SpreadsheetApp.openById(_PT.INFO_SS_ID);
}
/* ─────────────────────────────────────────────────────────────
   ① 비교표 만들기
   ───────────────────────────────────────────────────────────── */
/**
 * 비교표 만들기.
 *
 * ★ 미리 보고 나서 돌린다 ★  (2026-10-11 · 사장님: 「일단 확인하고 돌려야지」)
 *   ★ 2026-10-12 에 이 주석을 고쳤다 ★ 전에는 「상품정보시트에 341줄을
 *   쓴다」고 적어 두었다. ★둘 다 틀렸다★ —
 *     · 이 함수는 상품정보시트의 단가를 ★안 건드린다★. 「10월인상단가」
 *       탭만 만든다. 단가를 바꾸는 것은 partnerPriceRaiseApply 다
 *     · 341 은 어디서 센 수가 아니다. 지금 비교표는 357줄이다
 *       (못 찾음 36 + 짝지은 321). 매칭이 배우면 이 수는 움직인다
 *   숫자를 주석에 못 박으면, 다음에 읽는 사람이 그 수를 믿고 셈을 맞춘다.
 *
 *   이 함수는 「10월인상단가」 탭을 통째로 다시 만든다. 탭이 이미 있으면
 *   tab.clear() 로 지우고 다시 만든다 — ★체크해 둔 것이 다 날아간다★.
 *   그래서 셋으로 갈랐다:
 *     partnerPriceRaiseBuildPreview  아무것도 안 쓰고 무엇이 들어갈지 본다
 *     partnerPriceRaiseBuild         체크가 남아 있으면 ★멈추고 묻는다★
 *     partnerPriceRaiseBuildNow      편집기에서 「예」 대신 고르는 이름
 */
function partnerPriceRaiseBuildPreview() { _pr_build_(true); }
function partnerPriceRaiseBuild() { _pr_build_(false, false); }
/*  편집기에서 쓰는 이름 — 체크를 지우고 다시 만드는 것을 «안다»는 표시다 */
function partnerPriceRaiseBuildNow() { _pr_build_(false, true); }
/**
 * 옛 비교표에서 ★사람이 손으로 적은 것★ 만 걷어 온다.
 *
 * > 「매칭 잘못된거도 수정해놨어」
 * > 「미매칭건은 상품정보시트에 없는 경우도 많아.. 우리가 판매하지 않는 품목」
 *
 * 비교표를 다시 만들면 탭을 통째로 지운다. 그러면 못 찾은 줄에 손으로
 * 넣어 둔 우리코드와 「미판매」 표시가 ★말없이 사라진다★ — 38줄을 또
 * 처음부터 들여다보게 된다. 짝을 못 찾는 줄(근거가 ✖)만 업체·품명·박스로
 * 열쇠를 삼아 옮겨 온다. 짝을 찾은 줄은 건드리지 않는다 — 그 값의 주인은
 * 매칭이다([[one-value-one-owner]]).
 */
function _pr_oldHand_(tab) {
  var 광 = {};
  if (!tab) return 광;
  try {
    var last = tab.getLastRow();
    if (last < 2) return 광;
    var vals = tab.getRange(2, 1, last - 1, _PR_HEADERS_.length).getValues();
    for (var i = 0; i < vals.length; i++) {
      if (String(vals[i][_PR_C.근거 - 1] || "").indexOf("✖") !== 0) continue;
      var 코드 = String(vals[i][_PR_C.우리코드 - 1] || "").trim();
      if (!코드) continue;
      광[_pr_handKey_(vals[i][_PR_C.업체 - 1], vals[i][_PR_C.업체품명 - 1], vals[i][_PR_C.박스 - 1])] =
        { 코드: 코드, 적용후: vals[i][_PR_C.적용후 - 1] };
    }
  } catch (e) { Logger.log("[옛 손글씨] 못 읽었습니다 — " + e.message); }
  return 광;
}
/**
 * 옛 탭에서 ★짝지은 줄에 적혀 있던 코드★ 를 열쇠별로 모은다.
 *
 * ★ 왜 따로 세나 ★  (2026-10-12)
 * > 「매칭 잘못된거도 수정해놨어」
 *
 * 짝을 «못» 찾은 줄의 손글씨는 _pr_oldHand_ 가 되살린다. 그런데 짝을
 * ★잘못★ 찾은 줄을 사람이 고친 것은 되살릴 데가 없다 — 다시 만들면
 * _PR_PAIR_ 와 이름·값 셈으로 ★그 틀린 짝이 그대로 돌아온다★.
 * 누적품목매핑에 쌓아도 소용없다. 매칭은 그 탭을 «읽지 않는다»
 * (①배운짝은 파일에 박힌 _PR_PAIR_ 를 본다).
 *
 * 그래서 덮지도 않고 말없이 버리지도 않는다 — ★세어서 말하고★, 옛 탭을
 * 통째로 남긴다. 어느 쪽이 맞는지는 사람이 안다([[leave-no-ambiguous-branches]]).
 */
function _pr_oldCodes_(tab) {
  var 광 = {};
  if (!tab) return 광;
  try {
    var last = tab.getLastRow();
    if (last < 2) return 광;
    var vals = tab.getRange(2, 1, last - 1, _PR_HEADERS_.length).getValues();
    for (var i = 0; i < vals.length; i++) {
      var 코드 = String(vals[i][_PR_C.우리코드 - 1] || "").trim();
      if (!코드 || _pr_isNA_(코드)) continue;
      var k = _pr_handKey_(vals[i][_PR_C.업체 - 1], vals[i][_PR_C.업체품명 - 1], vals[i][_PR_C.박스 - 1]);
      if (!광[k]) 광[k] = [];
      광[k].push({ 코드: 코드, 이름: String(vals[i][_PR_C.우리상품명 - 1] || "") });
    }
  } catch (e) { Logger.log("[옛 코드] 못 읽었습니다 — " + e.message); }
  return 광;
}

/**  다시 만들기 전에 옛 탭을 통째로 남긴다. 사라지는 것이 없게. */
function _pr_backupTab_(ss, tab) {
  if (!tab) return "";
  try {
    var 이름 = _PR_TAB_ + "_이전";
    var 옛 = ss.getSheetByName(이름);
    if (옛) ss.deleteSheet(옛);
    var 새 = tab.copyTo(ss);
    새.setName(이름);
    새.hideSheet();
    return 이름;
  } catch (e) { Logger.log("[백업] 못 남겼습니다 — " + e.message); return ""; }
}

function _pr_handKey_(업체, 품명, 박스) {
  return [업체, 품명, 박스].map(function (x) { return String(x == null ? "" : x).trim(); }).join("|");
}

function _pr_build_(미리, 정말) {
  //  창이 없을 수도 있다(편집기) — _pr_say_ 가 알아서 로그로 간다
  var ss = _pr_ss_();
  var prods = _pr_loadProducts_();
  if (!prods.length) { _pr_say_("상품정보에서 품목을 못 읽었습니다."); return; }

  /*  못 찾은 줄의 «자리»와, 그중 단가가 «오른» 것. 오른 것은 그대로 두면
      우리가 옛 단가로 사게 된다 — 보고에서 따로 말한다.                  */
  var 못찾은줄 = [], 못찾고오름 = [];
  var rows = [], 셈 = { 고침: 0, 배움: 0, 이름: 0, 값: 0, 없음: 0, 줄: 0, 미판매: 0,
    값맞: 0, 값안맞: 0, 오름: 0 };

  /*  ★ 지우기 «전»에 걷는다 ★ 아래에서 탭을 통째로 지운다 — 그 뒤에는
      손으로 적어 둔 코드와 「미판매」를 읽을 데가 없다.                */
  var tab = ss.getSheetByName(_PR_TAB_);
  var 옛손 = _pr_oldHand_(tab);
  var 옛코드 = _pr_oldCodes_(tab);   // 짝지은 줄에 사람이 고쳐 둔 코드까지

  for (var i = 0; i < _PR_PRICE_.length; i++) {
    var p = _PR_PRICE_[i];
    var 업체 = p[0], 쪽 = p[1], 품명 = p[2], 박스 = p[3];
    var 종전 = p[4], 인상 = p[5], 동결 = p[6] === 1, 비고 = p[7];
    var 차 = (종전 != null && 인상 != null) ? Math.round((인상 - 종전) * 100) / 100 : "";
    var 율 = (차 !== "" && 종전) ? Math.round((차 / 종전) * 1000) / 10 : "";

    /*  ★ 오르는 줄만 셈한다 ★  (2026-10-12)
        단가표 180줄 중 ★실제로 오르는 것은 90줄★ 이고 나머지는 동결·내림이다.
        동결 줄은 짝이 틀려도 바뀌는 값이 없다 — 봐도 소용없다. 「봐야 할
        줄」에 그것까지 넣으면 수가 부풀어 「다 봐야 하나」가 된다.          */
    if (차 !== "" && Number(차) > 0) 셈.오름++;

    var m = _pr_match_(p, prods);
    if (m.근거.indexOf("ⓞ") === 0) 셈.고침++;
    else if (m.근거.indexOf("①") === 0) 셈.배움++;
    else if (m.근거.indexOf("②") === 0) 셈.이름++;
    else if (m.근거.indexOf("③") === 0) 셈.값++;
    else 셈.없음++;

    if (!m.목록.length) {
      /*  ★ 못 찾은 줄도 표에 넣는다 ★ 빼 버리면 「없는 일」이 된다.
          체크해도 적용은 안 된다(쓸 자리가 없다) — 사장님이 우리코드를
          손으로 넣으면 그때 적용된다. 그 줄을 따로 칠해 눈에 띄게 한다.   */
      /*  옛 탭에서 손으로 적어 둔 것이 있으면 그대로 되살린다 */
      var 손 = 옛손[_pr_handKey_(업체, 품명, 박스)] || null;
      var 손코드 = 손 ? 손.코드 : "";
      var 안팜 = _pr_isNA_(손코드);
      /*  ★ 되살린 코드는 체크도 되살린다 ★ 코드가 차면 색이 흰색으로 돌아가
          357줄 속에 묻힌다. 체크를 꺼 두면 사장님이 손으로 찾아 넣은 수고가
          조용히 묻힌 채 적용에서 빠진다. 「미판매」는 켜지 않는다.          */
      rows.push([(손코드 && !안팜) ? true : false, 업체, 품명, 박스, 종전, 인상, 차, 율, 동결 ? "동결" : "",
        비고, "", "", 손코드, "", "", (손 && !안팜 ? 손.적용후 : ""), m.근거, "",
        안팜 ? "미판매 — 우리가 안 파는 품목" : (손코드 ? "손으로 넣은 코드" : "코드를 넣어 주세요")]);
      if (안팜) 셈.미판매++; else 못찾은줄.push(rows.length + 1);
      /*  ★ 미판매는 셈에서 뺀다 ★ 안 파는 품목이 오른 것은 우리 손해가
          아니다. 다 싸잡으면 매번 같은 38줄을 다시 들여다보게 된다.      */
      if (!안팜 && 차 !== "" && Number(차) > 0) 못찾고오름.push(
        업체 + " · " + 품명 + " · " + (박스 || "") + " · " + 종전 + " → " + 인상 + " (+" + 차 + ")");
      셈.줄++;
      continue;
    }
    //  보기 좋은 차례 — 몸통 → 뚜껑 → 세트 → 그밖 → 소분
    var 순 = { "몸통": 1, "뚜껑": 2, "세트": 3, "그밖": 4, "소분": 5 };
    m.목록.sort(function (a, b) { return (순[a.u.kind] || 9) - (순[b.u.kind] || 9); });

    for (var j = 0; j < m.목록.length; j++) {
      var u = m.목록[j].u;
      var 적용후 = "";
      if (u.kind === "세트") {
        var s = _pr_setPrice_(비고);
        적용후 = s == null ? "" : s;          // 세트는 몸통+뚜껑 합이라 낱개가를 못 쓴다
      } else if (u.kind === "소분") {
        적용후 = "";                           // 소분 단가는 따로 계산된다
      } else {
        적용후 = (인상 == null) ? "" : 인상;
      }
      var 값맞 = (종전 != null && u.net != null && Math.abs(u.net - 종전) < 0.51) ? "O" : "";

      /*  ★ 손으로 볼 것을 좁힌다 ★  (2026-10-12 · 「일일히 다 매칭해야되는거야?」)
          ②이름·③값만 은 ★짐작★ 이다. 그중 우리 개당매입별도가가 업체가 적어
          준 종전단가와 같으면 — 같은 물건일 가능성이 크다. 다르면 둘 중 하나다:
          짝이 틀렸거나, 우리 단가가 이미 옛것이거나. 어느 쪽이든 ★사람이 봐야★
          하는 줄이다. 그 수를 알려 주면 「다 봐야 하나」에 답이 된다.         */
      /*  ★ 값이 실제로 바뀌는 줄만 ★ 이미 같은 값이면 적용에서도 건너뛴다 */
      var 바뀜 = (적용후 !== "" && 적용후 != null && u.net != null &&
        Number(적용후) !== Number(u.net));
      if (바뀜 && (m.근거.indexOf("②") === 0 || m.근거.indexOf("③") === 0)) {
        if (값맞 === "O") 셈.값맞++; else 셈.값안맞++;
      }

      /*  ★ 기본 체크 ★ 믿을 만한 것만 켠다.
          · ①②  켠다 (다만 바뀌는 값이 있고, 지금 값과 다를 때만)
          · ③·못찾음·소분·값 없는 세트  끈다 — 사람이 보고 켜야 한다  */
      var 켜기 = (m.근거.indexOf("ⓞ") === 0 || m.근거.indexOf("①") === 0 ||
        m.근거.indexOf("②") === 0) &&
        적용후 !== "" && u.net != null && Number(적용후) !== Number(u.net);

      rows.push([켜기, 업체, 품명, 박스, 종전, 인상, 차, 율, 동결 ? "동결" : "",
        비고, u.kind, m.목록[j].원장, u.code, u.name, u.net, 적용후, m.근거, 값맞, ""]);
      셈.줄++;
    }
  }

  /*  ★ 사람이 고쳐 둔 짝이 새 셈에 없나 ★  (2026-10-12)
      있으면 다시 만들 때 그 손질이 사라진다. 세어서 말한다 — 덮어쓸지
      말지는 사람이 정한다.                                            */
  var 새코드 = {};
  for (i = 0; i < rows.length; i++) {
    var k0 = _pr_handKey_(rows[i][_PR_C.업체 - 1], rows[i][_PR_C.업체품명 - 1], rows[i][_PR_C.박스 - 1]);
    var c0 = String(rows[i][_PR_C.우리코드 - 1] || "").trim();
    if (!새코드[k0]) 새코드[k0] = {};
    if (c0) 새코드[k0][c0] = true;
  }
  var 사라질것 = [];
  for (var k1 in 옛코드) {
    /*  짝을 못 찾는 열쇠는 _pr_oldHand_ 가 이미 되살린다 — 두 번 세지 않는다 */
    if (!새코드[k1] || !Object.keys(새코드[k1]).length) continue;
    for (var z = 0; z < 옛코드[k1].length; z++) {
      if (새코드[k1][옛코드[k1][z].코드]) continue;
      사라질것.push(k1.split("|").slice(0, 2).join(" · ") + " → " +
        옛코드[k1][z].코드 + " " + 옛코드[k1][z].이름.substring(0, 20));
    }
  }

  /*  ★ 미리보기는 여기서 돌아간다 ★ 위 셈은 다 읽기만 한 것이다.
      무엇이 들어갈지 적어 주고 아무것도 안 쓴다.                       */
  if (미리) {
    var 표본 = [];
    for (var v = 0; v < rows.length && v < 15; v++) {
      var q = rows[v];
      표본.push('  ' + (q[_PR_C.업체 - 1] || '') + ' · ' + (q[_PR_C.업체품명 - 1] || '')
        /*  ★ 키 이름을 지어내서 빈칸이 나왔다 ★  (2026-10-11)
            머리글은 「종전단가·인상단가·매칭근거」인데 _PR_C 의 키는
            「종전·인상·근거」다. 없는 키를 집으면 undefined - 1 = NaN 이고
            q[NaN] 은 undefined — ★오류 없이 빈칸★ 이 된다. 사장님 로그에
            「종전  →  」로 나왔다. 머리글 이름과 키 이름은 다르다.        */
        + ' · 종전 ' + (q[_PR_C.종전 - 1] || '') + ' → ' + (q[_PR_C.인상 - 1] || '')
        + ' · ' + (q[_PR_C.우리코드 - 1] || '(코드 못 찾음)')
        + ' · ' + (q[_PR_C.근거 - 1] || ''));
    }
    _pr_say_(
      '🧪 미리보기 — ★아무것도 쓰지 않았습니다★\n\n' +
      '단가표 ' + _PR_PRICE_.length + '줄 → 비교 ' + 셈.줄 + '줄이 들어갑니다\n\n' +
      (셈.고침 ? '  ⓞ고친짝 ' + 셈.고침 + '  ·' : '') +
      '  ①배운짝 ' + 셈.배움 + '  ·  ②이름·낱말 ' + 셈.이름 +
      '  ·  ③값만 ' + 셈.값 + '  ·  못 찾음 ' + 셈.없음 +
      (셈.미판매 ? '  (그중 미판매 표시 ' + 셈.미판매 + ' — 그대로 옮겨 옵니다)' : '') + '\n\n' +
      '── 손으로 보실 것 ──\n' +
      '  단가표 ' + _PR_PRICE_.length + '줄 중 ★실제로 오르는 것은 ' + 셈.오름 + '줄★ 입니다.\n' +
      '  ⓞ①는 실제 구매 기록에서 나온 짝이고, ②③ 중 종전단가가 맞는 ' + 셈.값맞 + '줄도 믿을 만합니다.\n' +
