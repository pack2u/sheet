      if (같은낱말.length) 겹친것.push({ u: 후보[z], 낱말: 같은낱말, 꼬리: "단가·이름" + 터 });
      else 단가만.push({ u: 후보[z], 낱말: [], 꼬리: "단가만" + 터 });
    }

    /*  ★ 단가로 못 찾으면 이름으로 찾는다 ★  (2026-10-12)
        우리 단가가 이미 달라진 품목은 「종전단가 = 현재단가」로 안 걸린다.
