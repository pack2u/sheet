  }
  SpreadsheetApp.flush();
  ui.alert("✅ 끝났습니다\n\n바꾼 줄 " + 바꿀것.length + " · 건너뛴 줄 " + 건너뜀.length +
    "\n\n옛 값은 「" + _PR_LOG_TAB_ + "」 탭에 남겼습니다.");
}

