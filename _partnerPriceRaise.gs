    else if (m.근거.indexOf("③") === 0) 셈.값++;
    else 셈.없음++;

    if (!m.목록.length) {
      rows.push([false, 업체, 품명, 박스, 종전, 인상, 차, 율, 동결 ? "동결" : "",
        비고, "", "", "", "", "", "", m.근거, "", ""]);
      셈.줄++;
      continue;
    }
    //  보기 좋은 차례 — 몸통 → 뚜껑 → 세트 → 그밖 → 소분
    var 순 = { "몸통": 1, "뚜껑": 2, "세트": 3, "그밖": 4, "소분": 5 };
    m.목록.sort(function (a, b) { return (순[a.u.kind] || 9) - (순[b.u.kind] || 9); });

    for (var j = 0; j < m.목록.length; j++) {
      var u = m.목록[j].u;
      var 적용후 = "";
      if (u.kind === "세트") {
        var s = _pr_setPrice_(비고);
        적용후 = s == null ? "" : s;          // 세트는 몸통+뚜껑 합이라 낱개가를 못 쓴다
      } else if (u.kind === "소분") {
        적용후 = "";                           // 소분 단가는 따로 계산된다
      } else {
        적용후 = (인상 == null) ? "" : 인상;
      }
      var 값맞 = (종전 != null && u.net != null && Math.abs(u.net - 종전) < 0.51) ? "O" : "";

      /*  ★ 기본 체크 ★ 믿을 만한 것만 켠다.
          · ①②  켠다 (다만 바뀌는 값이 있고, 지금 값과 다를 때만)
          · ③·못찾음·소분·값 없는 세트  끈다 — 사람이 보고 켜야 한다  */
      var 켜기 = (m.근거.indexOf("①") === 0 || m.근거.indexOf("②") === 0) &&
        적용후 !== "" && u.net != null && Number(적용후) !== Number(u.net);

      rows.push([켜기, 업체, 품명, 박스, 종전, 인상, 차, 율, 동결 ? "동결" : "",
        비고, u.kind, m.목록[j].원장, u.code, u.name, u.net, 적용후, m.근거, 값맞, ""]);
      셈.줄++;
    }
  }

  var tab = ss.getSheetByName(_PR_TAB_);
  if (tab) tab.clear(); else tab = ss.insertSheet(_PR_TAB_);
  tab.getRange(1, 1, 1, _PR_HEADERS_.length).setValues([_PR_HEADERS_])
    .setBackground("#1f4e79").setFontColor("white").setFontWeight("bold")
    .setHorizontalAlignment("center");
