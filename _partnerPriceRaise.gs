function partnerPriceRaiseApplyMapping() { _pr_mapping_(false); }
/*  편집기에서 쓰는 이름 — 위 적용과 같은 결이다 */
function partnerPriceRaiseApplyMappingNow() { _pr_mapping_(true); }
function _pr_mapping_(정말) {
  //  창이 없을 수도 있다(편집기) — _pr_say_ 가 알아서 로그로 간다
  var got = _pr_readChecked_();
  if (!got.줄.length) { _pr_say_("체크된 줄이 없습니다."); return; }

  var ss = _pr_ss_();
  var t = ss.getSheetByName(_PR_MAP_TAB_);
  if (!t) { _pr_say_("「" + _PR_MAP_TAB_ + "」 탭을 못 찾았습니다."); return; }

  var last = Math.max(t.getLastRow(), 1);
  var 기존 = last > 1 ? t.getRange(2, 1, last - 1, 6).getValues() : [];
  var 있나 = {};
  for (var i = 0; i < 기존.length; i++) {
    있나[String(기존[i][0]).trim() + "\u0000" + String(기존[i][2]).trim()] = true;
  }

  var 더할것 = [], 건너 = 0;
  for (i = 0; i < got.줄.length; i++) {
    var v = got.줄[i].v;
    var code = String(v[_PR_C.우리코드 - 1] || "").trim();
    var 우리명 = String(v[_PR_C.우리상품명 - 1] || "").trim();
    /*  업체상품명은 «원장 이름»을 먼저 쓴다 — 업체가 제 장부에 적는 이름이라
        다음 달 원장과 맞댈 때 그대로 걸린다. 없으면 단가표 품명을 쓴다. */
    var 업체명 = String(v[_PR_C.원장품명 - 1] || "").trim() ||
      String(v[_PR_C.업체품명 - 1] || "").trim();
    var 단가 = v[_PR_C.적용후 - 1];
    if (!code || !업체명) { 건너++; continue; }
    if (있나[code + "\u0000" + 업체명]) { 건너++; continue; }
    있나[code + "\u0000" + 업체명] = true;
    더할것.push([code, 우리명, 업체명, "", (단가 === "" || 단가 == null) ? "" : 단가, ""]);
  }

  if (!더할것.length) { _pr_say_("새로 쌓을 짝이 없습니다 (이미 있거나 업체명이 비었습니다).\n건너뜀 " + 건너); return; }
  if (!_pr_ask_("🔗 누적품목매핑에 쌓기",
    더할것.length + "개의 「우리품목 ↔ 업체품명」 짝을 더합니다.\n" +
    "이미 있는 짝은 건너뜁니다 (" + 건너 + "개).\n\n" +
    "이 표는 다음 달 정산에서 품목을 맞출 때 쓰입니다.",
    정말, "partnerPriceRaiseApplyMappingNow")) return;

  t.getRange(t.getLastRow() + 1, 1, 더할것.length, 6).setValues(더할것);
  _pr_say_("✅ " + 더할것.length + "개를 쌓았습니다.\n\n" +
    "정희·콤콤은 여태 이 표에 «한 줄도» 없었습니다 — 다음 달부터 품목 맞추기가 쉬워집니다.");
}

/* ─────────────────────────────────────────────────────────────
   점검 — 세트가 몸통+뚜껑과 맞나
   ───────────────────────────────────────────────────────────── */
/**
 * ★ 왜 이 점검이 필요한가 ★
 *   업체 단가표는 낱개(몸통·뚜껑)로 적히고, 우리 세트 단가는 그 둘의 합이다.
 *   실제로 105파이(대) 36+14=50, 인상 뒤 37+14.5=51.5 가 업체 비고 「셋51.5」와
 *   정확히 맞았다. 그런데 한쪽만 고치면 그 합이 깨진다 — 그리고 «조용히» 깨진다.
 *   세트로 파는 값이 틀리면 마진이 그만큼 사라진다.
 */
function partnerPriceRaiseCheckSets() {
  //  창이 없을 수도 있다(편집기) — _pr_say_ 가 알아서 로그로 간다
  var prods = _pr_loadProducts_();
  var 몸통 = {}, 뚜껑 = {}, i;
  for (i = 0; i < prods.length; i++) {
    var u = prods[i];
    if (u.net == null) continue;
    var base = _pr_norm_(u.name);
    if (u.kind === "몸통") 몸통[base] = u;
    else if (u.kind === "뚜껑") 뚜껑[base] = u;
  }
  var 말 = ["■ 세트 = 몸통 + 뚜껑 인가", ""];
  var 본것 = 0, 어긋남 = 0;
  for (i = 0; i < prods.length; i++) {
    if (prods[i].kind !== "세트" || prods[i].net == null) continue;
    var key = _pr_norm_(prods[i].name);
    var b = 몸통[key], l = 뚜껑[key];
    if (!b || !l) continue;
    본것++;
    var 합 = Math.round((b.net + l.net) * 100) / 100;
    if (Math.abs(합 - prods[i].net) < 0.51) continue;
    어긋남++;
    if (어긋남 <= 25) {
      말.push("  " + prods[i].code + "  " + prods[i].name.substring(0, 30));
      말.push("      세트 " + prods[i].net + "  ≠  몸통 " + b.net + " + 뚜껑 " + l.net + " = " + 합);
    }
  }
  말.push("");
  말.push("견준 세트 " + 본것 + "개 · 어긋남 " + 어긋남 + "개");
  if (!본것) 말.push("(몸통·뚜껑 이름이 세트와 달라 짝을 못 지었습니다)");
  Logger.log(말.join("\n"));
  _pr_say_(말.join("\n").substring(0, 1400));
}

/* ─────────────────────────────────────────────────────────────
   ⑥ 못 찾은 줄에 «후보» 찾아주기 — 단가로 찾는다
   ───────────────────────────────────────────────────────────── */
/**
 * 못 찾은 줄(주황)에 ★종전단가가 같은 품목★ 을 찾아 적어 준다.
 *
 * ★ 왜 이것이 맞나 ★  (2026-10-12)
 * 이름으로 맞추다 사고가 났다 — 「1호」가 「71호」 안에 들어 있었다.
 * 이름은 업체와 우리가 서로 다르게 부르지만, ★단가는 같은 물건을 가리킨다★.
 * 업체가 적어 준 종전단가와 우리 개당매입별도가가 같고 구매처도 같으면
 * 같은 물건일 가능성이 아주 크다.
 *
 * ★ 그래도 사람이 본다 ★
 *   · 후보가 ★하나뿐일 때만★ 우리코드 칸을 채운다
 *   · 그래도 ★적용 체크는 켜지 않는다★ — 사람이 보고 켜야 한다
 *   · 여럿이면 적용결과 칸에 늘어놓기만 한다. 고르는 것은 사람 몫이다
 *   · 이미 적힌 코드는 건드리지 않는다. 「미판매」도 건드리지 않는다
 *
 * 박스수량이 적혀 있으면 한 겹 더 거른다 — 같은 단가라도 박스가 다르면
 * 다른 물건이다.
 */
/**
 * 두 이름이 ★낱말 하나라도★ 겹치나.
 *
 * ★ 왜 생겼나 ★  (2026-10-12)
 * 단가와 박스수량만 보고 채웠더니 이런 것이 나왔다 —
 *   정희 · 밀폐20155  →  JH 158파이 삼계탕 중 400개---몸통  (73원 · 400개)
 * 밀폐용기인데 삼계탕을 집었다. 단가 73 과 박스 400 이 ★우연히★ 같았다.
 * 180줄 × 3,000품목이면 우연은 반드시 나온다.
 *
 * 숫자 덩어리(20155·4칸)와 두 글자 이상 낱말(소스·용기·뚜껑)을 뽑아
 * 하나라도 겹치는지 본다. 안 겹치면 ★채우지 않고 적어만 둔다★ —
 * 없애지는 않는다. 맞는 것일 수도 있고, 그건 사람이 안다.
 */
function _pr_tokens_(글) {
  var t = String(글 == null ? "" : 글).toLowerCase();
  var 모음 = {};
  /*  ★ 숫자 덩어리는 세 자리부터 ★ 20155·1200 은 뜻이 있고 1·4 는 없다 */
  var 숫자 = t.match(/[0-9]{3,}/g) || [];
  for (var i = 0; i < 숫자.length; i++) 모음[숫자[i]] = true;
  /*  ★ 「25호」·「4칸」은 한 덩어리다 ★  (2026-10-12)
      「25호」는 숫자 두 자리 + 한 글자라 위 두 가지에 다 걸러졌다 —
      「JH 실링 191465 (25호) 화이트」와 한 낱말도 안 겹쳤다.
      숫자가 앞에 다 붙으므로 「1호」가 「71호」를 집는 일은 없다
      (71호는 「71호」 한 덩어리로 나온다).                             */
  var 호칸 = t.match(/[0-9]+[가-힣]/g) || [];
  for (i = 0; i < 호칸.length; i++) 모음[호칸[i]] = true;
  /*  ★ 한글은 띄어쓰기가 없다 ★  (2026-10-12)
      처음엔 낱말 통째로 재다가 「칸사각소스용기」와 「칸소스용기」가
      한 덩어리씩이라 안 겹쳤다 — 맞는 짝을 떨어뜨릴 뻔했다.
      두 글자씩 겹쳐 가며 나눈다: 소스·용기·사각 같은 것이 걸린다.      */
  /*  ★ 영문은 세 글자부터 ★  (2026-10-12)
      「JH신죽(중)」이 「JHS105AUCE…」와 ★jh★ 로 겹쳤다. 우리 품목은 거의
      다 JH·BF·CC 로 시작한다 — 두 글자 영문은 알맹이가 없다. 그걸
      「이름겹침」이라 부르면 믿을 것과 못 믿을 것이 섞인다.
      한글은 두 글자면 뜻이 있다(소스·용기·밀폐). 영문만 세 글자로 올린다. */
  var 한글 = t.match(/[가-힣]{2,}/g) || [];
  for (i = 0; i < 한글.length; i++) {
    var w = 한글[i];
    for (var j = 0; j + 2 <= w.length; j++) 모음[w.substring(j, j + 2)] = true;
  }
  var 영문 = t.match(/[a-z]{3,}/g) || [];
  for (i = 0; i < 영문.length; i++) {
    var e = 영문[i];
    for (var q = 0; q + 3 <= e.length; q++) 모음[e.substring(q, q + 3)] = true;
  }
  return 모음;
}

/**
 * 겹친 낱말이 얼마나 ★센가★.
 *
 * ★ 왜 생겼나 ★  (2026-10-12)
 * 이름으로 찾기를 넣었더니 이런 것이 올라왔다 —
 *   정희 · 신95파이(소)  →  MAJHG0022(이름만 ★파이★)
 *   정희 · 밀폐20155     →  JHMINIJJIM00001(이름만 ★밀폐★)
 * 「파이」·「뚜껑」·「밀폐」는 수백 품목에 다 들어 있다 — 겹쳐도 알맹이가
 * 없다. 반면 ★숫자★ 는 품번이다: 19153·12144·25호 가 겹치면 거의 그 물건이다.
 *   숫자가 든 낱말  3점   (19153 · 12144 · 25호 · 68파)
 *   한글 두 글자    1점   (파이 · 뚜껑 · 밀폐 · 사각)
 * 「이름만」 후보는 ★2점부터★ 보여 준다 — 흔한 한글 하나로는 안 걸린다.
 */
function _pr_tokenScore_(낱말들) {
  var 점 = 0;
  for (var i = 0; i < 낱말들.length; i++) 점 += /[0-9]/.test(낱말들[i]) ? 3 : 1;
  return 점;
}

/**  겹치는 낱말을 돌려준다. 없으면 빈 배열. */
function _pr_shareTokens_(가, 나) {
  var A = _pr_tokens_(가), B = _pr_tokens_(나), 같은 = [];
  for (var k in A) if (B[k]) 같은.push(k);
  return 같은;
}

/**
 * 구매처가 ★같나·비었나·다른가★.  (후보찾기에서만 쓴다)
 *
 * ★ 왜 생겼나 ★  (2026-10-12)
 * 「12144 뚜껑」·「미니탕용기(대)투톤」이 「후보 없음」으로 나왔다. 이름도
