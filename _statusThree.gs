/**
 * ══════════════════════════════════════════════════════════════
 *  상태는 세 가지만 쓴다 — 판매중 · 품절 · 단종품
 *  2026-10-12
 *
 *  > 사장님: "일단 판매, 품절만 사용하게 해줘"
 *  > 그중 단종품은 남기기로 했다 — 발주 화면이 「단종된 품목입니다」를
 *  >   계속 말할 수 있어야 사람이 재입고를 기다리지 않는다.
 *
 * ───────────────────────────────────────────────────────────────
 *  ★ 왜 「상태」 탭 뒤에서 접나 ★
 *
 *  상태 낱말은 이카운트 CLASS_CD3 에서 오는데, 「상태」 탭(statusMap)이
 *  폴백보다 **우선**한다. 그래서 moveToEcount 의 else-if 가지만 줄이면
 *  **아무 일도 일어나지 않는다** — 탭이 먼저 답해 버리기 때문이다.
 *
 *  탭을 손으로 고치게 하는 대신, 탭이 답한 **뒤에** 한 번 접는다.
 *  그러면 탭이 무엇이든 결과가 세 가지로 보장된다.
 *
 * ───────────────────────────────────────────────────────────────
 *  ★ 모르는 낱말은 «접지 않는다» ★  [[dont-overwrite-what-you-couldnt-read]]
 *
 *  아는 일곱만 접는다. 새 낱말이 생기면 **그대로 흘려보낸다** —
 *  v2 의 /api/products/ingest 가 「모르는 상태」로 세어 구글 챗 카드를 띄운다
 *  (「⚠ 품목 미러 — 확인이 필요합니다」). 거기서 사람이 어디로 접을지 정한다.
 *
 *  짐작으로 「판매중」에 넣으면 팔면 안 되는 물건을 14개 몰에 올린다.
 *  「품절」에 넣으면 파는 물건을 조용히 죽인다. 둘 다 안 한다.
 *
 * ───────────────────────────────────────────────────────────────
 *  ★ 되돌리려면 ★  _ST3_ON_ 을 false 로. 접기가 멈추고 일곱 낱말이 돌아온다.
 *
 *  ★ 딸려 오는 것 ★  상태를 이카운트로 «밀면»(pushToEcount) 이제 CLASS_CD3 가
 *    9001·9003·9004 세 개로 정리된다. 9002(재고까지만)·9007(소싱중)·
 *    9006(상세제작중)·9005(특판/할인)는 밀 때마다 지워진다. 그것이 이 결정의
 *    뜻이다 — 다만 「밀지 않으면」 이카운트 쪽은 그대로 남는다.
 * ══════════════════════════════════════════════════════════════
 */

/** 접기를 켤까. false 로 두면 일곱 낱말이 그대로 간다 */
var _ST3_ON_ = true;

/** 쓰기로 한 세 가지 */
var _ST3_WORDS_ = ['판매중', '품절', '단종품'];

/**
 * 아는 낱말 → 세 가지.
 *
 * ★ 품절임박이 「판매중」인 까닭 ★  아직 파는 물건이다. 136건이다.
 *   「품절」로 뭉개면 아직 팔 수 있는 136개가 14개 몰에서 죽는다.
 *
 * ★ 소싱중·상세제작중이 「품절」인 까닭 ★  아직 못 판다. 주문이 들어오면
 *   취소가 된다. 「판매중」으로 두면 그 취소를 우리가 만드는 것이다.
 */
var _ST3_MAP_ = {
  '판매중': '판매중',
  '판매중(재고까지만)': '판매중',
  '품절임박': '판매중',
  '특판/할인': '판매중',
  '품절': '품절',
  '소싱중': '품절',
  '상세제작중': '품절',
  '상세제작종': '품절',   // 옛 글자. 시트에 남아 있을 수 있다
  '단종품': '단종품'
};

/**
 * 상태 낱말을 세 가지로 접는다.
 *
 * @param {string} 낱말  「상태」 탭이나 폴백이 낸 값
 * @return {string} 세 가지 중 하나. 모르는 낱말이면 **받은 것 그대로**
 */
function _st3_fold_(낱말) {
  var s = String(낱말 == null ? '' : 낱말).trim();
  if (!_ST3_ON_ || !s) return s;
  var 접힘 = _ST3_MAP_[s];
  return 접힘 ? 접힘 : s;   // 모르는 낱말은 안 건드린다 — v2 가 세어서 알린다
}

/** 세 가지 안에 드는 낱말인가 (검사용) */
function _st3_isThree_(낱말) {
  return _ST3_WORDS_.indexOf(String(낱말 == null ? '' : 낱말).trim()) >= 0;
}
